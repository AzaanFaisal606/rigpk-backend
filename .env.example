# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two modes, chosen automatically:
#
#   * TURSO_DATABASE_URL set   -> hosted Turso (libSQL). DB_PATH is ignored.
#   * TURSO_DATABASE_URL unset -> local SQLite file at DB_PATH (dev/offline).
#
# Get the two Turso values with:
#     turso db show ppc --url        # -> TURSO_DATABASE_URL
#     turso db tokens create ppc     # -> TURSO_AUTH_TOKEN
# The auth token is a SECRET — never commit it. In CI, store it as a GitHub
# Actions secret, not in this file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite path (used only when TURSO_DATABASE_URL is empty).
DB_PATH=data/ppc.db

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Allowed CORS origin for the frontend
FRONTEND_URL=http://localhost:3000
